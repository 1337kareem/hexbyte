# Copy this file to .env. Never commit .env.
PORT=8788

# Prune: every spell goes through Prune to Gemini. Add your Gemini key in Prune first.
PRUNE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tiger Data: your service's connection string. Without it, duels save to server/data/.
DATABASE_URL=

# Auth0: a Single Page Application in your tenant. Without these, players join as guests.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Shared with the Auth0 Action for the Ritual Gate. Any random string of 32 or more characters.
GATE_SECRET=
# Face login: a Regular Web Application ("HexByte Face Login") with the Password and
# Client Credentials grants, authorized for the Management API (read, create, update users).
AUTH0_FACE_CLIENT_ID=
AUTH0_FACE_CLIENT_SECRET=

# Solana devnet: the Duel Ledger's signing key (a random 32-byte seed, base64). Fund its
# address at https://faucet.solana.com (Devnet). Without it, the ledger is off.
SOLANA_SECRET_KEY=
# Optional: another devnet RPC endpoint.
SOLANA_RPC_URL=
