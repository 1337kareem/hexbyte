# Copy this file to .env. Never commit .env.
PORT=8788

# Prune: every spell goes through Prune to Gemini. Add your Gemini key in Prune first.
PRUNE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tiger Data: your service's connection string. Without it, duels save to server/data/.
DATABASE_URL=

# Auth0: a Single Page Application in your tenant. Without these, players join as guests.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
# Shared with the Auth0 Action for the Rune Gate. Any random string of 32 or more characters.
RUNE_SECRET=
